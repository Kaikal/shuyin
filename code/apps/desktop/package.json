{
  "name": "shuyin-desktop",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.5.25",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . --noEmit && vite build",
    "build:web": "vite build --config vite.singlefile.config.ts",
    "build:app": "tauri build --no-bundle",
    "build:installer": "tauri build --bundles nsis",
    "preview": "vite preview",
    "typecheck": "tsc -p . --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^3",
    "@shuyin/core": "workspace:*",
    "@shuyin/lx-provider": "workspace:*",
    "@shuyin/theme-engine": "workspace:*",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-fs": "^2.0.2",
    "@tauri-apps/plugin-opener": "^2.2.5",
    "@tauri-apps/plugin-store": "^2.1.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
