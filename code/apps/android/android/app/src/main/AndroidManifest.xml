<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 在线播放会话持 WifiLock：本机熄屏后 WiFi 会休眠（实测 75s 后 ping 全丢），
         换歌那几秒没有 ExoPlayer 的网锁，取链全报 Unable to resolve host，播完就停 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 只用于「跳系统对话框请求加入电池优化白名单」：Doze 一进就掐后台网络，在线歌必停 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 长按拿起歌单卡时轻震一下（排序的「拿起来了」反馈）。安装期权限，不弹授权框 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 本地音乐库：Android 13 起按类型授权，13 之前走外部存储读 -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
        下载落到公共「音乐」文件夹：Android 10 起走 MediaStore（无需权限），
        只有 9 及以下需要这条写权限，所以用 maxSdkVersion 限住。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 后台播放：前台服务 + 通知（13 起通知要单独授权） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        跨应用锁屏拉起的兜底：直接 startActivity 被 ROM 的「后台弹出界面」appop
        拦掉时（1.2s 无回执），由系统闹钟代发一颗 PendingIntent 再试一次
        （见 PlaybackService.screenRx / LockActivity.alarmPending）。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 悬浮歌词：「显示在其他应用上层」。特殊权限，装上不生效，
         首次开启时会跳系统设置页让用户手动允许（见 FloatingLyrics）。
         持有它同时豁免「后台不许启动 Activity」限制——跨应用锁屏的
         直接 startActivity 靠的就是这条。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        应用内更新：下载完 APK 之后直接拉起系统安装器（见 UpdateApk）。

        这条权限声明只是「允许这个应用去请求安装」，**不代表能静默安装**：
        Android 8 起还得用户在「安装未知应用」里单独给我们开一次，
        没开时原生会跳到那个设置页（`ACTION_MANAGE_UNKNOWN_APP_SOURCES`）。
        不声明的话 `canRequestPackageInstalls()` 恒 false，设置页也进不去。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 频谱不再需要 RECORD_AUDIO。
         以前靠 android.media.audiofx.Visualizer，那是「采集系统输出音频」，
         系统只认录音权限；换成 ExoPlayer 之后，PCM 是在自己进程里解码出来、
         送去扬声器之前旁路一份（见 TapAudioProcessor），一个权限都不用要。
         这一条删掉之后，应用装到手机上连「麦克风」都不会出现在权限列表里。 -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              「其他应用打开」送进来的音源脚本。

              场景：别人在微信/QQ 里发来一个音源脚本（.js），点开 → 系统问用哪个应用打开 →
              疏音要出现在这个列表里，进来之后由前端弹确认框问「要导入吗」。
              原生只负责把文件摆到桌上，**不替用户决定导入**（见 MainActivity.handleIncoming）。
            -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/javascript" />
                <data android:mimeType="text/javascript" />
                <data android:mimeType="application/x-javascript" />
            </intent-filter>
            <!--
              国内 IM 发 .js 时常常上报成「未知类型」(application/octet-stream)，
              不认这一条的话「其他应用打开」列表里根本没有疏音。
              代价是别的未知类型文件也会把我们列进去——导入前的确认框兜住误触。
            -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!--
              歌单文件。洛雪的 `.lxmc` 一般上报成未知类型，上面那条已经兜住；
              这里补的是**系统认得出类型**的那些——JSON 导出的歌单、m3u/pls 列表。
              不加这条的话，在文件管理器里点「用其他应用打开」看不到疏音。
            -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/json" />
                <data android:mimeType="audio/x-mpegurl" />
                <data android:mimeType="audio/mpegurl" />
                <data android:mimeType="application/vnd.apple.mpegurl" />
            </intent-filter>
        </activity>

        <!--
            锁屏播放页的「跨应用宿主」（2026-11-18 晚）。

            用户在别的应用里熄屏时，主窗口在后台、showWhenLocked 挂了也看不见；
            老做法把主任务 moveTaskToFront 拉上来，退场只有 moveTaskToBack（=按 Home），
            实测解锁必落桌面。现在改成独立 Activity：
              · 自有 taskAffinity + excludeFromRecents：主任务一个像素都不动；
              · showWhenLocked 让它盖在 keyguard 上（API 27+ 生效，运行时另有旧标志兜底）；
              · 退场 finish() —— 独立任务整个消失，压在底下的原应用亮回来。
            界面复用 LockScreenPanel（纯原生、宿主无关）。应用内熄屏仍走主窗口里的
            那一层（见 LockScreenPanel 注释），两条路互不干扰。
        -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:theme="@style/LockTheme"
            android:launchMode="singleTask"
            android:taskAffinity="cn.shuyin.player.lock"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            tools:targetApi="27" />

        <!-- 平台登录：内嵌各家的官方登录页，从 CookieManager 取凭证。
             不 export，只能由应用自己拉起。 -->
        <activity
            android:name=".PlatformLoginActivity"
            android:exported="false"
            android:theme="@style/AppTheme"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize" />

        <!-- 锁屏播放页已并入 MainActivity（见 LockScreenPanel）：
             它是主窗口里的一层覆盖视图，窗口标志在运行时按开关动态挂，
             所以这里不再留独立 Activity —— 少一个 Activity，就少一套会跟播放器
             脱节的状态，也少一次「后台启动被系统拦掉」。 -->

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- 「我是个媒体应用」的标准声明。系统（华为控制中心 / 车机 / Android Auto）
             除了看 MediaSession，还会看应用有没有实现 MediaBrowserService——
             真机上酷狗 / 酷我 / 网易云 / QQ 音乐四家全都实现了，我们原来没有，
             所以控制中心一直画「未在播放」。见 MediaBrowserBridge。 -->
        <service
            android:name=".MediaBrowserBridge"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
            安装包的出口。

            Android 7 起 `file://` 一律抛 `FileUriExposedException`，装包只能给 content://。
            authority 用 `${applicationId}.fileprovider`：phone / car 两个 applicationId
            各算各的，装在同一台设备上也不会撞。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 媒体键落点：会话失活时系统把耳机/蓝牙按键发成这个广播。
             必须 exported —— 发广播的是系统（蓝牙、SystemUI），不是我们自己。
             见 MediaButtonReceiver 顶部的注释：华为控制中心也拿它当「这 App 是播放器」的凭证。 -->
        <receiver
            android:name=".MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
