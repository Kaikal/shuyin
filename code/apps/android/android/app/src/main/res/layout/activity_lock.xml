<?xml version="1.0" encoding="utf-8"?>
<!--
  锁屏播放页（QQ 音乐那种「音乐锁屏」）。

  为什么做成一个 Activity 而不是悬浮窗：系统锁屏是**盖在所有窗口之上**的，
  TYPE_APPLICATION_OVERLAY 浮窗只能在解锁后才看得见，压不到锁屏上。
  只有带 showWhenLocked 的 Activity 才能显示在锁屏界面。

  结构：整屏封面（压暗）→ 时钟 → 歌名歌手 → 两行 KTV 歌词 → 播控 → 上滑解锁。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <ImageView
        android:id="@+id/lk_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- 压暗：封面再亮也得让白字读得清；上下各一层，中间留一点通透 -->
    <View
        android:id="@+id/lk_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/lk_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingTop="54dp"
        android:paddingBottom="26dp">

        <TextView
            android:id="@+id/lk_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="46sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:includeFontPadding="false"
            android:shadowColor="#66000000"
            android:shadowDy="2"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/lk_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="#CCFFFFFF" />

        <!--
          多行歌词：当前句在正中，上下各两条越远越淡（LyricBoard 的 multi 模式）。
          位置在**歌名上面**——用户定的：一眼先看到正在唱的那句，歌名歌手在它下面兜底。
        -->
        <cn.shuyin.player.LyricBoard
            android:id="@+id/lk_lyrics"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/lk_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:shadowColor="#66000000"
            android:shadowDy="2"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/lk_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="#B3FFFFFF" />

        <!--
          这里**不再插弹性间距**：歌词板已经用 weight=1 吃掉了剩余高度。
          以前在这一带放 Space，歌名和进度条之间就会空出一大截
          （用户：「中间空着一截」）—— 留白该待在歌词区里，不在两个控件之间。
        -->

        <!-- 进度行：音乐锁屏不能只有三个键，没有进度条这一屏会显得空洞 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lk_pos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="34dp"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="#B3FFFFFF"
                android:fontFamily="sans-serif-medium" />

            <ProgressBar
                android:id="@+id/lk_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/lk_bar" />

            <TextView
                android:id="@+id/lk_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="34dp"
                android:gravity="end"
                android:text="0:00"
                android:textSize="11sp"
                android:textColor="#8CFFFFFF"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/lk_fav"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:scaleType="center"
                android:padding="10dp"
                android:contentDescription="收藏" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/lk_prev"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:scaleType="center"
                android:padding="12dp"
                android:contentDescription="上一首" />

            <ImageButton
                android:id="@+id/lk_play"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="@android:color/transparent"
                android:scaleType="center"
                android:padding="10dp"
                android:contentDescription="播放 / 暂停" />

            <ImageButton
                android:id="@+id/lk_next"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@android:color/transparent"
                android:scaleType="center"
                android:padding="12dp"
                android:contentDescription="下一首" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 和对面的收藏对称，让播放键保持在正中 -->
            <Space
                android:layout_width="44dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <!--
          上滑引导：**三层重叠的向上箭头 + 文字**，无边框、无底色。

          用户的两点要求：
            · 「加个图标引导用户拖动，我不知道拖哪」——之前只有一行 12sp 灰字，看着像页脚；
            · 「不要边界，用那个三个重叠的向上弯箭头」——所以去掉了胶囊底和描边，
              改成三条 chevron 叠放（越上越亮），像 QQ 音乐锁屏那种「一直往上推」。
          整体还会做上下浮动（见 LockScreenActivity 里对 lk_hint_arrow 的动画）。
        -->
        <LinearLayout
            android:id="@+id/lk_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="@null"
            android:clickable="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:id="@+id/lk_hint_arrow"
                android:layout_width="30dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/lk_arr_top"
                    android:layout_width="30dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|center_horizontal"
                    android:alpha="0.95"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/lk_chevron_up" />

                <ImageView
                    android:id="@+id/lk_arr_mid"
                    android:layout_width="30dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="7dp"
                    android:alpha="0.55"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/lk_chevron_up" />

                <ImageView
                    android:id="@+id/lk_arr_bot"
                    android:layout_width="30dp"
                    android:layout_height="12dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="14dp"
                    android:alpha="0.28"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/lk_chevron_up" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="上滑收起"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp"
                android:letterSpacing="0.06" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
